# --- Database ---
# Local dev (XAMPP MySQL, user root, no password):
DB_URL=mysql+pymysql://root:@localhost:3306/statejar
# Railway production (from the MySQL plugin's variables):
# DB_URL=mysql+pymysql://root:PASSWORD@HOST:PORT/railway

# --- Auth ---
# Long random string (32+ chars), e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Provider-key encryption (AES-256-GCM) ---
# Any strong random string; it is hashed to a 32-byte key.
AES_KEY=replace-with-a-long-random-secret

# --- CORS ---
# JSON list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","https://statejar.vercel.app","https://statejar.com","https://www.statejar.com"]

# --- Local models (Ollama) ---
# Where the local Ollama daemon listens.
OLLAMA_BASE_URL=http://localhost:11434
# Off by default so production never advertises laptop-only models.
# Set true for the offline/finale demo, then pick "ollama/llama3.2".
SHOW_OLLAMA=false

# --- Extraction ---
# "auto" (default) runs the GLiNER stage of the pipeline whenever it can be
# loaded, so no fact is missed just because no regex anticipated the phrasing.
# gliner/torch live in requirements-ml.txt and are NOT installed on Railway,
# so production silently runs the rule engine alone. "gliner" is an explicit
# synonym for auto; "rules" forces the deterministic engine on its own.
#
# NOTE: extraction feeds canonicalization, so a machine with the extras
# installed will mint different handles from one without for the same text.
# Set "rules" everywhere if you need handles to match across environments.
EXTRACTOR_MODE=auto

# --- Retrieval ---
# false (default, production) or true to fall back to sentence-transformers
# embeddings when the keyword intent map matches nothing. sentence-transformers
# also lives in requirements-ml.txt and is NOT installed on Railway; if it is
# missing this silently stays on the intent map. Read path only — it can never
# change a handle.
RETRIEVER_SEMANTIC=false
